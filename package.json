{
  "name": "path.ux",
  "version": "0.2.0",
  "description": "Html5 based UI library with blender-rna-style data binding",
  "main": "scripts/pathux.ts",
  "index": "scripts/pathux.ts",
  "browser": "true",
  "exports": {
    ".": "./scripts/pathux.ts",
    "./eslint/*": "./buildtools/eslint-rules/*.mjs",
    "./eslint/*.mjs": "./buildtools/eslint-rules/*.mjs",
    "./*": "./*"
  },
  "scripts": {
    "build": "node buildtools/esbuild.mjs",
    "gen:paths": "node buildtools/gen-datapaths.mjs",
    "gen:themes": "node buildtools/gen-themes.mjs",
    "typecheck:themes": "npx tsgo --noEmit -p tsconfig.themes.json",
    "watch": "node buildtools/esbuild.mjs --watch",
    "typecheck": "npx tsgo --noEmit && npx tsgo --noEmit -p example/tsconfig.json",
    "emitTypes": "npx tsgo --project tsconfigDecl.json",
    "buildPackage": "bash buildtools/build_package_new.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "format": "node node_modules/@pathtx/prettier/bin/prettier.cjs --log-level warn --cache --write \"{scripts,example}/**/*.{ts,js}\" \"{documentation,specs}/**/*.md\" \"*.md\"",
    "format:check": "node node_modules/@pathtx/prettier/bin/prettier.cjs --log-level warn --cache --check \"{scripts,example}/**/*.{ts,js}\" \"{documentation,specs}/**/*.md\" \"*.md\"",
    "render-icons": "bash render_icons.sh",
    "markdown-toc": "bash run_markdown_toc.sh",
    "serv": "node serv.js",
    "nwjs": "node buildtools/nwjs.mjs",
    "electron": "node buildtools/electron.mjs",
    "cdp": "node buildtools/cdp.mjs",
    "playwright": "npx playwright test",
    "lint": "pnpm run lint:eslint && pnpm run lint:prose",
    "lint:check": "pnpm run lint:eslint:check && pnpm run lint:prose",
    "lint:eslint": "pnpm exec eslint-dispatcher --fix",
    "lint:eslint:check": "pnpm exec eslint-dispatcher",
    "lint:eslint:clean-cache": "rm -rf .eslintcache-d .eslintcache",
    "lint:prose": "node node_modules/comment-lint/bin/commentlint.js --concise"
  },
  "directories": {
    "doc": "documentation"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pathtx/eslint-dispatcher": "^0.0.3",
    "@pathtx/prettier": "3.10.0-dev",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@types/parse5": "^7.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260406.1",
    "comment-lint": "^0.5.0",
    "diff": "^5.2.2",
    "electron": "^43.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.0",
    "globals": "^17.4.0",
    "happy-dom": "^20.9.0",
    "jiti": "^2.7.0",
    "markdown-toc": "^1.2.0",
    "nstructjs": "^0.8.12",
    "nw": "0.112.0-sdk",
    "parse5": "6.0.0",
    "path.ux": "link:",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "typescript-language-server": "^5.1.3",
    "vitest": "^4.1.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joeedh/path.ux.git"
  },
  "author": "Joseph Eagar",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/joeedh/path.ux/issues"
  },
  "homepage": "https://github.com/joeedh/path.ux#readme",
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "comment-lint",
      "esbuild",
      "unrs-resolver"
    ],
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}
